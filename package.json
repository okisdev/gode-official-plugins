{
  "name": "gode-official-plugins",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "node --test scripts/*.test.ts && pnpm -r --workspace-concurrency=1 --no-bail test",
    "typecheck": "pnpm -r check && tsc --noEmit -p scripts",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "index": "node scripts/index.mjs",
    "release": "node scripts/release.mjs",
    "catalog": "node scripts/catalog.mjs"
  },
  "devDependencies": {
    "@gode/format": "link:../gode/packages/format",
    "@gode/plugin-sdk": "link:../gode/packages/plugin-sdk",
    "@types/node": "catalog:",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "catalog:",
    "wrangler": "4.141.0"
  }
}
